library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity mult_8b_top is 
   port(
   clk, reset : in std_logic ;  
   ps2d, ps2c:  in  std_logic; --comunicação teclado
   tx :         out std_logic  --saida uart -> pc

   );

end mult_8b_top;

architecture arch of mult_8b_top is 
--sinais   
   signal make_code: std_logic_vector(7 downto 0); --teclado
   signal extend, press: std_logic; --teclado
   signal k_done_tick: std_logic; --teclado

   constant DVSR: std_logic_vector(10 downto 0) := std_logic_vector(to_unsigned(324, 11)); --uart
   signal wr_uart: std_logic; --uart
   signal w_data: std_logic_vector(7 downto 0); --uart

   signal m_start : std_logic; --multiplicador 
   signal x_in : std_logic_vector(7  downto 0);  --multiplicador 
   signal y_in : std_logic_vector(7  downto 0);  --multiplicador 
   signal m_idle : std_logic;  --multiplicador 
   signal m_done_tick : std_logic;  --multiplicador 
   signal z_out : std_logic_vector(15  downto 0);  --multiplicador 

   signal c_start :std_logic;
   signal bcd2 : std_logic_vector(3 downto 0);
   signal bcd1 : std_logic_vector(3 downto 0);
   signal bcd0 : std_logic_vector(3 downto 0);
   signal ready:std_logic; 
   signal c_done_tick : std_logic; 
   signal bin : std_logic_vector(7 downto 0) ;


   signal erro : std_logic;
   signal x_done_tick : std_logic; --indica que todos os digitos de x foram recebidos
   signal digito_numerico : std_logic; --flag circuito combinacional, make_code2bcd
   signal bcd : std_logic_vector(3 downto 0); -- armazena conversão make_code2bcd, circuito combinacional

   type state_type is (idle, tecla_igual_x, tecla1_x, tecla2_x, tecla3_x, armazena_x, tecla_enter_x, tecla_igual_y, tecla1_y, tecla2_y, armazena_y, tecla_enter_y) ;
   signal state_reg, state_next : state_type;
   signal x_bcd2_reg, x_bcd1_reg, x_bcd0_reg :unsigned(3 downto 0);
   signal x_bcd2_next, x_bcd1_next, x_bcd0_next :unsigned(3 downto 0);
   signal y_bcd2_reg, y_bcd1_reg, y_bcd0_reg :unsigned(3 downto 0);
   signal y_bcd2_next, y_bcd1_next, y_bcd0_next :unsigned(3 downto 0);
   signal x_sign_reg, x_sign_next : std_logic;
   signal y_sign_reg, y_sign_next : std_logic;
   signal valid_reg, valid_next :std_logic;
   signal counter_reg, counter_next : unsigned(2 downto 0); 
   signal in_bcd2_reg, in_bcd1_reg, in_bcd0_reg :unsigned(3 downto 0);
   signal in_bcd2_next, in_bcd1_next, in_bcd0_next :unsigned(3 downto 0);
   signal in_sign_reg, in_sign_next : std_logic;




begin
-- Instancia Teclado PS2
  
   keyboard_0: entity work.keybord(behavioral)
      port map(
         clk       => clk, --in
         reset     => reset,  --in
         ps2d      => ps2d,  --in
         ps2c      => ps2c, --in
         make_code => make_code, --saida -> signal 
         extend    => extend, --saida -> signal
         press     => press,  --saida -> signal
         done_tick => k_done_tick --saida -> signal
      );               
  
   -- Instancia da UART

   uart_0: entity work.uart(str_arch)
      generic map (
         DBIT    => 8,   -- # data bits
         SB_TICK => 16,  -- # ticks for stop bits, 16 per bit
         FIFO_W  => 4    -- # FIFO addr bits (depth: 2^FIFO_W)
      )
      port map(
         clk      => clk, --in
         reset    => reset, --in
         rd_uart  => '0',  
         dvsr     => DVSR, --in -> signal
         wr_uart  => wr_uart, --in -> signal
         rx       => '1', 
         w_data   => w_data, --in -> signal
         tx_full  => open, 
         rx_empty => open, 
         r_data   => open,
         tx       => tx --saida
      );

   mult_0 : entity work.mult_booth(shift_add_sub_arch)
      -- generic map( ) não precisa de generic map, valor default é para 8 bits, valor usado nessa aplicação
      port map (
         clk       => clk,  --in
         reset     => reset, --in 
         m_start => m_start , --in -> signal    ,sinal de entrada que inicia operação 1 bit
         x_in => x_in ,    --in -> signal
         y_in => y_in ,    --in -> signal
         m_idle => m_idle ,  --saida -> signal    ,flag indica sistema ocioso
         m_done_tick => m_done_tick,  --saida -> signal     ,flag indica que operação terminou
         z_out => z_out  --saida -> signal
      );
   
   bcd2bin_0: entity work.bcd2bin(arch)
      port map (
         clk       => clk, 
         reset     => reset, 
         start => c_start , --in -> signal
         bcd2 => bcd2 ,  --in -> signal
         bcd1 => bcd1 ,  --in -> signal
         bcd0 => bcd0, --in -> signal
         ready => ready, --saida -> signal      ,flag indica conversor ocioso
	      done_tick => c_done_tick,  --saida -> signal       ,flag indica conversão terminou
         bin => bin --saida -> signal

      );

   process(clk, reset)
      begin 
      if reset = '1' then
         state_reg <= idle;
         state_reg <= (others=>'0');
         x_bcd2_reg <= (others=>'0');
         x_bcd1_reg <= (others=>'0');
         x_bcd0_reg <= (others=>'0');
         y_bcd2_reg <= (others=>'0');
         y_bcd1_reg <= (others=>'0');
         y_bcd0_reg <= (others=>'0');
         x_sign_reg <= (others=>'0');
         y_sign_reg <= (others=>'0');
         valid_reg <= (others=>'0');
         counter_reg <= (others=>'0');
         in_bcd2_reg <= (others=>'0');
         in_bcd1_reg <= (others=>'0');
         in_bcd0_reg <= (others=>'0');
   

         
      elsif (clk'event and clk='1') then
         state_reg <= idle;
         state_reg <= (others=>'0');
         x_bcd2_reg <= x_bcd2_next;
         x_bcd1_reg <= x_bcd1_next;
         x_bcd0_reg <= x_bcd0_next;
         y_bcd2_reg <= y_bcd2_next;
         y_bcd1_reg <= y_bcd1_next;
         y_bcd0_reg <= y_bcd0_next;
         x_sign_reg <= x_sign_next;
         y_sign_reg <= y_sign_next;
         valid_reg <= valid_next;
         counter_reg <= counter_next;
         in_bcd2_reg <= in_bcd2_next;
         in_bcd1_reg <= in_bcd1_next;
         in_bcd0_reg <= in_bcd0_next;         
         in_sign_reg <= in_sign_next; 
      end if;
   end process;

   --logica proximo estado
   process(state_reg, make_code, extend, press, k_done_tick, wr_uart, w_data, m_start, x_in, y_in, m_idle, m_done_tick, z_out, c_start, bcd2,
           bcd1, bcd0, ready, c_done_tick, bin, erro,  digito_numerico, x_done_tick, bcd)
   begin
      state_next <= state_reg;--saidas defalt
      x_bcd2_next <= x_bcd2_reg;
      x_bcd1_next <= x_bcd1_reg;
      x_bcd0_next <= x_bcd0_reg;
      y_bcd2_next <= y_bcd2_reg;
      y_bcd1_next <= y_bcd1_reg;
      y_bcd0_next <= y_bcd0_reg;
      x_sign_next <= x_sign_reg;
      y_sign_next <= y_sign_reg;
      valid_next <= valid_reg;
      counter_next <= counter_reg;
      erro <= '0';   

      case state_reg is
         when idle =>
            counter_next <= '0'; --zero contador , ele indica numero de caracteres guardados, talvez isso deva estar em outro estado
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if make_code = "22" then --x
                        state_next <= tecla_igual_x;
                     elsif make_code = "35" then --y
                        state_next <= tecla_igual_y;
                     elsif make_code = "1b" then --s
                        state_next <= exibir; 
                     elsif make_code = "4d" then -- p
                        state_next <= multiplicar;
                     end if;
                  end if;
               end if;
            end if;



         when tecla_igual_x => 
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if make_code = "55" then --  '='
                        state_next <= tecla1_x;
                     else -- se não for = é uma tecla invalida
                        erro <= '1';
                     end if;
                  else -- se for extendida é uma tecla invalida
                     erro <= '1';               
                  end if;
               end if;
            end if;
         
         when tecla1_x => 
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if make_code = "55" then -- digito de signal '+'
                        in_sign_next <= '0';
                        counter_next <= counter_reg + 1; --counter tem papel de controle, evita repetições do caracter de signal
                        if counter_reg ='1' then --signifca que digitei caracter "+" mais de uma vez
                           erro <= '1'; --obs esta incompleto, apenas indicar erro não é o bastante, provavelmente aqui vou ter que zerar counter_reg 
                        end if;
                     elsif make_code = "4e "then -- digito de signal "-"
                        in_sign_next <= '1'; 
                        counter_next <= counter_reg + 1; --counter tem papel de controle, evita repetições do caracter de signal
                        if counter_reg ='1' then --signifca que digitei caracter "-" mais de uma vez
                           erro <= '1';
                        end if;
                     elsif digito_numerico = "1" then
                        in_bcd2_next <= bcd ; --valor vem de circuito combinacional que transforma make_code em bcd, bcd mais significativo é guardado
                        counter_next <= 1; --seto counter em 1 => 1 bcd armazenado. Agora variavel tem uma função diferente, contagem de digitos armazenados
                        state_next <= tecla2_x;
                     end if;
                  else -- se for extendida é uma tecla invalida
                     erro <= '1';                           
                  end if;                                          
               end if;
            end if;   

         when tecla2_x =>
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if digito_numerico = "1" then 
                        in_bcd1_next <= bcd;
                        counter_next <= counter_reg + 1;
                        state_next <= tecla3_x;
                     elsif make_code ="5a" then -- "enter"
                        x_done_tick <= '1'; -- indica que terminou de receber o valor de x
                        state_next <= armazena_x;
                     else -- se não for numero nem enter é uma tecla invalida 
                        erro <= '1';
                     end if;
                  else -- se for extendida é uma tecla invalida
                     erro <= '1';                           
                  end if;                           
               end if;
            end if;   

         when tecla3_x =>
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if digito_numerico = "1" then 
                        in_bcd0_next <= bcd; --bcd menos significativo
                        counter_next <= counter_reg + 1;
                        state_next <= tecla_enter_x;
                     elsif make_code ="5a" then
                        x_done_tick <= '1'; -- indica que terminou de receber o valor de x
                        state_next <= armazena_x;
                     else -- se não for numero nem enter é uma tecla invalida 
                        erro <= '1';
                     end if;
                  else -- se for extendida é uma tecla invalida
                     erro <= '1';                           
                  end if;                           
               end if;
            end if;   

         when tecla_enter_x =>
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if make_code ="5a" then
                        x_done_tick <= '1'; -- indica que terminou de receber o valor de x
                        state_next <= armazena_x;
                     else -- se não for numero nem enter é uma tecla invalida 
                        erro <= '1';
                     end if;
                  else -- se for extendida é uma tecla invalida
                     erro <= '1';                           
                  end if;                           
               end if;
            end if;   
         
         when armazena_x => --  Corrige o valor BCD conforme a quantidade de dígitos  
            
            counter_next <= '0';           
            if counter_reg = '1' then 
            in_bcd0_next <= in_bcd2_reg ; -- "desloco"  bcd2 => bcd0  
            elsif counter_reg = '2' then
            in_bcd0_next <= in_bcd1_reg ; --  "desloco"  bcd1 => bcd0
            in_bcd1_next <= in_bcd2_reg ; --  "desloco"  bcd2 => bcd1
            else -- se counter_reg = '3' então não preciso ajustar posição, mas verifico se esta na faixa.     
               if in_bcd2_reg = "1" or in_bcd2_reg = "0" then
                  if in_bcd1_reg = "2" or in_bcd1_reg = "1" or in_bcd1_reg = "0" then
                     if in_bcd0_reg < 8 and in_sign_reg = '0' then
                     x_bcd0_next  <= in_bcd0_reg ; 
                     x_bcd1_next <= in_bcd1_reg ;
                     x_bcd2_next <= in_bcd2_reg ;
                     x_sign_next <= '0';  
                     elsif in_bcd0_reg < 9 and in_sign_reg = '1' then
                     x_bcd0_next <= in_bcd0_reg ; 
                     x_bcd1_next <= in_bcd1_reg ;
                     x_bcd2_next <= in_bcd2_reg ;
                     x_sign_next <= '1';   
                     end if;
                  end if;
               end if;


            end if; 
 


      end case;

      
   end process;


   --circuitos combinaicinais conversão make_code2bcd
   process(make_code)
   begin
      bcd <= (others=>'0');
      digito_numerico <= '1';
      case make_code is
         when "10110" => bcd <= "0001"; --1
         when "11110" => bcd <= "0010"; --2
         when "100110" => bcd <= "0011"; --3
         when "" => bcd <= "0100"; --4                 
         when "" => bcd <= "0101"; --5
         when "" => bcd <= "0110"; --6
         when "" => bcd <= "0111"; --7
         when "" => bcd <= "1000"; --8
         when "" => bcd <= "1001"; --9
         when "" => bcd <= "0000"; --0
         when "othes" => digito_numerico <= "0"; 

   end process;
   
   end arch;
