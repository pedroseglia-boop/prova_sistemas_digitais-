library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity mult_8b_top is 
   port(
   clk, reset : in std_logic ;  
   ps2d, ps2c:  in  std_logic; --comunicaÃ§Ã£o teclado
   tx :         out std_logic  --saida uart -> pc

   );

end mult_8b_top;

architecture arch of mult_8b_top is 
--sinais circuitos instanciados

   --keybord  
   signal make_code: std_logic_vector(7 downto 0); --teclado
   signal extend, press: std_logic; --teclado
   signal k_done_tick: std_logic; --teclado

   --uart
   constant DVSR: std_logic_vector(10 downto 0) := std_logic_vector(to_unsigned(324, 11)); --uart
   signal wr_uart: std_logic; --uart
   signal w_data: std_logic_vector(7 downto 0); --uart


   --multiplicador
   signal m_start : std_logic;  
   -- x_in Ã© um registrador e nÃ£o um sinal     
   -- y_in Ã© um registrador e nÃ£o um sinal  
   signal m_idle : std_logic;  
   signal m_done_tick : std_logic;  
   signal z_out : std_logic_vector(15  downto 0);  

   --bcd2bin
   signal c_start_bcd2bin :std_logic;
   signal bcd2_in : std_logic_vector(3 downto 0);
   signal bcd1_in : std_logic_vector(3 downto 0);
   signal bcd0_in : std_logic_vector(3 downto 0);
   signal ready_bcd2bin:std_logic; 
   signal c_done_tick_bcd2bin : std_logic; 
   signal bin_out : std_logic_vector(7 downto 0) ;

   --bin2bcd
   signal c_start_bin2bcd :std_logic;
   signal bin_in : std_logic_vector(7 downto 0) ;
   signal ready_bin2bcd : std_logic; 
   signal c_done_tick_bin2bcd : std_logic;
   signal bcd2_out : std_logic_vector(3 downto 0);
   signal bcd1_out : std_logic_vector(3 downto 0);
   signal bcd0_out : std_logic_vector(3 downto 0);


--sinais para os circuitos combinacionais

   --circuito combinacional, make_code2bcd
   signal digito_numerico : std_logic; --flag 
   signal bcd : std_logic_vector(3 downto 0); -- armazena conversÃ£o 

   
--sinais maquina de estados
   --flags ainda sem funÃ§Ã£o definida
   signal erro : std_logic; --valor invalido inserido
   signal x_done_tick : std_logic; --indica que todos os digitos de x foram recebidos   


   type state_type is (idle, tecla_igual_x, tecla1_x, tecla2_x, tecla3_x, armazena_x,
    tecla_enter_x, tecla_igual_y, tecla1_y, tecla2_y, armazena_y, tecla_enter_y,
    start_bcd2bin, wait_bcd2bin) ;
   signal state_reg, state_next : state_type;
   signal x_bcd2_reg, x_bcd1_reg, x_bcd0_reg :unsigned(3 downto 0);
   signal x_bcd2_next, x_bcd1_next, x_bcd0_next :unsigned(3 downto 0);
   signal y_bcd2_reg, y_bcd1_reg, y_bcd0_reg :unsigned(3 downto 0);
   signal y_bcd2_next, y_bcd1_next, y_bcd0_next :unsigned(3 downto 0);
   signal x_sign_reg, x_sign_next : std_logic;
   signal y_sign_reg, y_sign_next : std_logic;
   signal valid_reg, valid_next :std_logic;
   signal counter_reg, counter_next : unsigned(2 downto 0); 
   --guarda o valor de entrada temporariamente para converÃ§Ã£o
   signal in_bcd2_reg, in_bcd1_reg, in_bcd0_reg :unsigned(3 downto 0);
   signal in_bcd2_next, in_bcd1_next, in_bcd0_next :unsigned(3 downto 0);
   signal in_sign_reg, in_sign_next : std_logic; 

   --guarda operandos da multiplicaÃ§Ã£o temporariamente, enquanto aguarda a ordem de multiplicar
   signal x_in_reg, x_in_next : std_logic_vector(7 downto 0);
   signal y_in_reg, y_in_next :  std_logic_vector(7 downto 0);

   signal conv_ctrl_reg, conv_ctrl_next  : std_logic_vector (1 downto 0); -- controle da conversÃ£o , indica se estou convertendo x => 01 , y=> 10 ou nenhum deles 00 



begin
-- Instancia Teclado PS2
  
   keyboard_0: entity work.keybord(behavioral)
      port map(
         clk       => clk, --in
         reset     => reset,  --in
         ps2d      => ps2d,  --in
         ps2c      => ps2c, --in
         make_code => make_code, --saida -> signal 
         extend    => extend, --saida -> signal
         press     => press,  --saida -> signal
         done_tick => k_done_tick --saida -> signal
      );               
  
   -- Instancia da UART

   uart_0: entity work.uart(str_arch)
      generic map (
         DBIT    => 8,   -- # data bits
         SB_TICK => 16,  -- # ticks for stop bits, 16 per bit
         FIFO_W  => 4    -- # FIFO addr bits (depth: 2^FIFO_W)
      )
      port map(
         clk      => clk, --in
         reset    => reset, --in
         rd_uart  => '0',  
         dvsr     => DVSR, --in -> signal
         wr_uart  => wr_uart, --in -> signal
         rx       => '1', 
         w_data   => w_data, --in -> signal
         tx_full  => open, 
         rx_empty => open, 
         r_data   => open,
         tx       => tx --saida
      );

   mult_0 : entity work.mult_booth(shift_add_sub_arch)
      -- generic map( ) nÃ£o precisa de generic map, valor default Ã© para 8 bits, valor usado nessa aplicaÃ§Ã£o
      port map (
         clk       => clk,  --in
         reset     => reset, --in 
         m_start => m_start , --in -> signal    ,sinal de entrada que inicia operaÃ§Ã£o 1 bit
         x_in => x_in_reg ,    --in -> signal aqui eu ponho o valor reg ou valor next ? 
         y_in => y_in_reg ,    --in -> signal
         m_idle => m_idle ,  --saida -> signal    ,flag indica sistema ocioso
         m_done_tick => m_done_tick,  --saida -> signal     ,flag indica que operaÃ§Ã£o terminou
         z_out => z_out  --saida -> signal
      );
   
   bcd2bin_0: entity work.bcd2bin(arch)
      port map (
         clk       => clk, 
         reset     => reset, 
         start => c_start_bcd2bin , --in -> signal
         bcd2 => bcd2_in ,  --in -> signal
         bcd1 => bcd1_in ,  --in -> signal
         bcd0 => bcd0_in, --in -> signal
         ready => ready_bcd2bin, --saida -> signal      ,flag indica conversor ocioso
	      done_tick => c_done_tick_bcd2bin,  --saida -> signal       ,flag indica conversÃ£o terminou
         bin => bin_out --saida -> signal

      );
   bin2bcd_0 : entity work.bin2bcd(arch)
   port map(
      clk        => clk,
      reset      => reset,
      start      => c_start_bin2bcd,
      bin        =>  bin_in, --adaptar , entradas não compativeis, bin maior que bin_in  
      ready      => ready_bin2bcd, 
      done_tick  => c_done_tick_bin2bcd ,
      bcd3 => open,
      bcd2 => bcd2_out,
      bcd1 => bcd1_out,
      bcd0 => bcd0_out
   );


   process(clk, reset)
      begin 
      if reset = '1' then
         state_reg <= idle;
         x_bcd2_reg <= (others=>'0');
         x_bcd1_reg <= (others=>'0');
         x_bcd0_reg <= (others=>'0');
         y_bcd2_reg <= (others=>'0');
         y_bcd1_reg <= (others=>'0');
         y_bcd0_reg <= (others=>'0');
         x_sign_reg <= '0';
         y_sign_reg <= '0';
         valid_reg <= '0';
         counter_reg <= (others=>'0');
         in_bcd2_reg <= (others=>'0');
         in_bcd1_reg <= (others=>'0');
         in_bcd0_reg <= (others=>'0');
         conv_ctrl_reg <= (others=>'0');
   

         
      elsif (clk'event and clk='1') then
         state_reg <= idle;
         x_bcd2_reg <= x_bcd2_next;
         x_bcd1_reg <= x_bcd1_next;
         x_bcd0_reg <= x_bcd0_next;
         y_bcd2_reg <= y_bcd2_next;
         y_bcd1_reg <= y_bcd1_next;
         y_bcd0_reg <= y_bcd0_next;
         x_sign_reg <= x_sign_next;
         y_sign_reg <= y_sign_next;
         valid_reg <= valid_next;
         counter_reg <= counter_next;
         in_bcd2_reg <= in_bcd2_next;
         in_bcd1_reg <= in_bcd1_next;
         in_bcd0_reg <= in_bcd0_next;         
         in_sign_reg <= in_sign_next; 
         conv_ctrl_reg <= conv_ctrl_next;
      end if;
   end process;

   --logica proximo estado
   process(state_reg, make_code, extend, press, k_done_tick, 
            wr_uart, w_data, 
            m_start, m_idle, m_done_tick, z_out,  --x_in e y_in sÃ£o registradores, nÃ£o entram na lista de sensibilidade
            c_start_bcd2bin, bcd2_in, bcd1_in, bcd0_in, ready_bcd2bin, c_done_tick_bcd2bin, bin_out, 
            c_start_bin2bcd, bin_in, ready_bin2bcd, c_done_tick_bin2bcd, bcd2_out, bcd1_out, bcd0_out, 
            erro,  digito_numerico, x_done_tick, bcd)
   begin
      state_next <= state_reg;--saidas defalt
      x_bcd2_next <= x_bcd2_reg;
      x_bcd1_next <= x_bcd1_reg;
      x_bcd0_next <= x_bcd0_reg;
      y_bcd2_next <= y_bcd2_reg;
      y_bcd1_next <= y_bcd1_reg;
      y_bcd0_next <= y_bcd0_reg;
      x_sign_next <= x_sign_reg;
      y_sign_next <= y_sign_reg;
      valid_next <= valid_reg;
      counter_next <= counter_reg;
      in_bcd2_next <= in_bcd2_reg;
      in_bcd1_next <= in_bcd1_reg;
      in_bcd0_next <= in_bcd0_reg;         
      in_sign_next <= in_sign_reg; 
      conv_ctrl_next <= conv_ctrl_reg;

      erro <= '0';   
      x_done_tick <= '0';

      case state_reg is
         when idle =>
            counter_next <= '0'; --zero contador , ele indica numero de caracteres guardados, talvez isso deva estar em outro estado
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if make_code = "22" then --x
                        state_next <= tecla_igual_x;
                     elsif make_code = "35" then --y
                        state_next <= tecla_igual_y;
                     elsif make_code = "1b" then --s
                        state_next <= exibir; 
                     elsif make_code = "4d" then -- p
                        state_next <= multiplicar;
                     end if;
                  end if;
               end if;
            end if;



         when tecla_igual_x => 
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if make_code = "55" then --  '='
                        state_next <= tecla1_x;
                     else -- se nÃ£o for = Ã© uma tecla invalida
                        erro <= '1';
                     end if;
                  else -- se for extendida Ã© uma tecla invalida
                     erro <= '1';               
                  end if;
               end if;
            end if;
         
         when tecla1_x => 
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if make_code = "55" then -- digito de signal '+'
                        in_sign_next <= '0';
                        counter_next <= counter_reg + 1; --counter tem papel de controle, evita repetiÃ§Ãµes do caracter de signal
                        if counter_reg ='1' then --signifca que digitei caracter "+" mais de uma vez
                           erro <= '1'; --obs esta incompleto, apenas indicar erro nÃ£o Ã© o bastante, provavelmente aqui vou ter que zerar counter_reg 
                        end if;
                     elsif make_code = "4e "then -- digito de signal "-"
                        in_sign_next <= '1'; 
                        counter_next <= counter_reg + 1; --counter tem papel de controle, evita repetiÃ§Ãµes do caracter de signal
                        if counter_reg ='1' then --signifca que digitei caracter "-" mais de uma vez
                           erro <= '1';
                        end if;
                     elsif digito_numerico = "1" then
                        in_bcd2_next <= bcd ; --valor vem de circuito combinacional que transforma make_code em bcd, bcd mais significativo Ã© guardado
                        counter_next <= 1; --seto counter em 1 => 1 bcd armazenado. Agora variavel tem uma funÃ§Ã£o diferente, contagem de digitos armazenados
                        state_next <= tecla2_x;
                     end if;
                  else -- se for extendida Ã© uma tecla invalida
                     erro <= '1';                           
                  end if;                                          
               end if;
            end if;   

         when tecla2_x =>
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if digito_numerico = "1" then 
                        in_bcd1_next <= bcd;
                        counter_next <= counter_reg + 1;
                        state_next <= tecla3_x;
                     elsif make_code ="5a" then -- "enter"
                        state_next <= armazena_x;
                     else -- se nÃ£o for numero nem enter Ã© uma tecla invalida 
                        erro <= '1';
                     end if;
                  else -- se for extendida Ã© uma tecla invalida
                     erro <= '1';                           
                  end if;                           
               end if;
            end if;   

         when tecla3_x =>
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if digito_numerico = "1" then 
                        in_bcd0_next <= bcd; --bcd menos significativo
                        counter_next <= counter_reg + 1;
                        state_next <= tecla_enter_x;
                     elsif make_code ="5a" then
                        state_next <= armazena_x;
                     else -- se nÃ£o for numero nem enter Ã© uma tecla invalida 
                        erro <= '1';
                     end if;
                  else -- se for extendida Ã© uma tecla invalida
                     erro <= '1';                           
                  end if;                           
               end if;
            end if;   

         when tecla_enter_x =>
            if k_done_tick = '1' then 
               if press = '1' then
                  if extend = '0' then
                     if make_code ="5a" then
                        state_next <= armazena_x;
                     else -- se nÃ£o for numero nem enter Ã© uma tecla invalida 
                        erro <= '1';
                     end if;
                  else -- se for extendida Ã© uma tecla invalida
                     erro <= '1';                           
                  end if;                           
               end if;
            end if;   
         
         when armazena_x => --  Corrige o valor BCD conforme a quantidade de dÃ­gitos  
            counter_next <= '0'; --zero contagem           
            state_next <= start_bcd2bin;
            conv_ctr_next <= "01"; --informa  para start_bcd2bin que estou convertendo o valor de x
            x_done_tick <= '1'; -- indica que terminou de receber o valor de x, nÃ£o sei se vou usar essa flag
            if counter_reg = '1' then 
            x_bcd0_next <= in_bcd2_reg ; -- "desloco"  bcd2 => bcd0  
            elsif counter_reg = '2' then
            x_bcd0_next <= in_bcd1_reg ; --  "desloco"  bcd1 => bcd0
            x_bcd1_next <= in_bcd2_reg ; --  "desloco"  bcd2 => bcd1
            
            else -- se counter_reg = '3' entÃ£o nÃ£o preciso ajustar posiÃ§Ã£o, mas verifico se esta na faixa.     
               if in_bcd2_reg = "1" or in_bcd2_reg = "0" then
                  if in_bcd1_reg = "2" or in_bcd1_reg = "1" or in_bcd1_reg = "0" then
                     if in_bcd0_reg < 8 and in_sign_reg = '0' then
                     x_bcd0_next  <= in_bcd0_reg ; 
                     x_bcd1_next <= in_bcd1_reg ;
                     x_bcd2_next <= in_bcd2_reg ;
                     x_sign_next <= '0';  
                     elsif in_bcd0_reg < 9 and in_sign_reg = '1' then
                     x_bcd0_next <= in_bcd0_reg ; 
                     x_bcd1_next <= in_bcd1_reg ;
                     x_bcd2_next <= in_bcd2_reg ;
                     x_sign_next <= '1';   
                     end if;
                  end if;
               end if;
            end if; 
 
         when start_bcd2bin => -- pergunta : conversor ocioso?  se sim comeÃ§a converÃ§Ã£o, veja essa pergunta parece inutil, nÃ£o sei existe um caso em que ele esteja ocupado. 
            state_next <= wait_bcd2bin; 
            if conv_ctr_reg ="01" and ready_bcd2bin = '1' then -- se estamos convertando valor de x => 01 
            bcd2_in <= x_bcd2_reg;
            bcd1_in <= x_bcd1_reg;
            bcd0_in <= x_bcd0_reg;
            c_start_bcd2bin <= '1';
            
            elsif conv_ctr_reg ="10" and ready_bcd2bin = '1' then -- se estamos convertando valor de y => 10 
            bcd2_in <= y_bcd2_reg;
            bcd1_in <= y_bcd1_reg;
            bcd0_in <= y_bcd0_reg;
            c_start_bcd2bin <= '1';
            end if;
               
         when wait_bcd2bin => --
            if conv_ctr_reg ="01" and c_done_tick_bcd2bin = '1' then -- se estamos convertando valor de x => 01 e bcd2bin terminou  converÃ§Ã£o entÃ£o
               conv_ctr_reg <= "00"; --Zero para evitar lixo
               state_next <= idle; --volto para idle a espera de novo comando
               if x_sign_reg = '1' then --se valor for negativo
                  x_in_next  <= std_logic_vector( unsigned(not bin_out) + 1) ; --faÃ§o complemento de 2 e guardo
               else --se valor for positivo
                  x_in_next <= bin_out; --apenas guardo
               end if; 
            elsif conv_ctr_reg ="01" and c_done_tick_bcd2bin = '1' then -- se estamos convertando valor de y => 10 e bcd2bin terminou  converÃ§Ã£o entÃ£o
               conv_ctr_reg <= "00";  --Zero para evitar lixo
               state_next <= idle; --volto para idle a espera de novo comando
               if y_sign_reg = '1' then --se valor for negativo
                  y_in_next  <= std_logic_vector( unsigned(not bin_out) + 1) ;  --faÃ§o complemento de 2 e guardo
               else --se valor for positivo
                  y_in_next <= bin_out; --apenas guardo
               end if;             
            end if;

      end case;

      
   end process;


   --circuitos combinaicinais conversÃ£o make_code2bcd
   process(make_code)
   begin
      bcd <= (others=>'0');
      digito_numerico <= '1';
      case make_code is
         when "00010110" => bcd <= "0001"; --1
         when "00011110" => bcd <= "0010"; --2
         when "00100110" => bcd <= "0011"; --3
         when "00100101" => bcd <= "0100"; --4                 
         when "00101110" => bcd <= "0101"; --5
         when "00110110" => bcd <= "0110"; --6
         when "00111101" => bcd <= "0111"; --7
         when "00111110" => bcd <= "1000"; --8
         when "01000110" => bcd <= "1001"; --9
         when "01000101" => bcd <= "0000"; --0
         when others => digito_numerico <= '0'; 
      end case;
   end process;
   
   end arch;
